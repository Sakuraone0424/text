# No real credentials. Fill only on the separately authorized host (0600).
CANDIDATE_NETWORK_PROFILE=private_https
CANDIDATE_COOKIE_SECURE=1
CANDIDATE_PRIVATE_ORIGIN=https://REPLACE-WITH-APPROVED-HOST.ts.net
CANDIDATE_PRIVATE_UNTIL=REPLACE-WITH-EXPLICIT-TIMEZONE-AWARE-EXPIRY
CANDIDATE_REVIEW_SCHEMA=source_staging_real_20261026
CANDIDATE_REVIEW_DATABASE_NAME=REPLACE-WITH-AUTHORIZED-NONPRODUCTION-DATABASE
CANDIDATE_SESSION_SECRET=SET-PRIVATELY-ON-HOST
CANDIDATE_REVIEW_USERS=SET-INDIVIDUAL-ACCOUNT-PBKDF2-HASHES-PRIVATELY
SOURCE_STAGING_DATABASE_URL=SET-LOCAL-SCRAM-AUTHENTICATED-DSN-PRIVATELY
CANDIDATE_BACKUP_ROOT=/var/lib/ustc-review/backups
CANDIDATE_BACKUP_POINTER=/var/lib/ustc-review/backups/current.json
CANDIDATE_PG_BIN=/usr/lib/postgresql/17/bin
