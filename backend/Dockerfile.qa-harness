# Separate QA-only Harness image. Never replace the legacy production Dockerfile.
FROM python:3.12-slim-bookworm
WORKDIR /app
COPY backend/requirements.txt backend/requirements-harness.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-harness.txt
COPY backend/app ./app
COPY backend/harness ./harness
COPY backend/config ./config
COPY backend/sql ./sql
COPY backend/migrate.py ./migrate.py
ENV PYTHONDONTWRITEBYTECODE=1 \
    AI_AUTOMATION_ENABLED=0 \
    QA_HARNESS_EXECUTION_ENABLED=0 \
    QA_IMPORT_ENABLED=0 \
    DEEPSEEK_API_AUTHORIZED=0 \
    DEEPSEEK_PRIVATE_DATA_AUTHORIZED=0 \
    OTEL_SDK_DISABLED=true
CMD ["python", "-m", "app.qa_harness_tick"]
