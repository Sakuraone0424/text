{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "backend/Dockerfile.qa-harness"
  },
  "deploy": {
    "startCommand": "python -m app.qa_harness_tick",
    "cronSchedule": "*/10 * * * *",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 1
  }
}
